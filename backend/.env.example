APP_NAME=Resume Matching Agent
SECRET_KEY=change-this-in-production

# Local default DB (no Docker needed)
DATABASE_URL=sqlite:///./resume_matching.db

# Redis is optional for local mode unless you run Celery worker/beat
REDIS_URL=redis://localhost:6379/0

# Optional services (only needed if you use MinIO/Qdrant integrations)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=resumes
QDRANT_URL=http://localhost:6333
